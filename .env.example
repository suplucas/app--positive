EXPO_PUBLIC_API_URL=http://localhost:3001
# MapTiler (OSM) para o mapa. Sem key, o app usa OSM padrão só em dev.
EXPO_PUBLIC_MAP_TILES_KEY=

# Upload de foto da avaliação direto no S3 (AWS SDK na tela de compose).
# O bucket precisa aceitar PUT com ACL public-read e expor publicBaseUrl.
EXPO_PUBLIC_S3_BUCKET=
EXPO_PUBLIC_S3_REGION=us-east-1
EXPO_PUBLIC_S3_PUBLIC_BASE_URL=
EXPO_PUBLIC_S3_ACCESS_KEY_ID=
EXPO_PUBLIC_S3_SECRET_ACCESS_KEY=
